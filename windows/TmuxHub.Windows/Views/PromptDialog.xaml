<Window x:Class="TmuxHub.Windows.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="220" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="PromptText" FontSize="14" FontWeight="SemiBold"
               TextWrapping="Wrap" />
    <TextBox x:Name="ValueBox" Grid.Row="1" Margin="0,14,0,0"
             KeyDown="ValueBox_OnKeyDown" />
    <TextBlock x:Name="HelpText" Grid.Row="2" Margin="1,8,1,0"
               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Style="{StaticResource BaseButton}" MinWidth="82"
              IsCancel="True" />
      <Button Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="82"
              Margin="8,0,0,0" IsDefault="True" Click="ConfirmButton_OnClick" />
    </StackPanel>
  </Grid>
</Window>
