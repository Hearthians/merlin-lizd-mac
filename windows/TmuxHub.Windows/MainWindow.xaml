<Window x:Class="TmuxHub.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TmuxHub" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        Icon="/TmuxHub.Windows;component/Assets/TmuxHub.Windows.ico"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="286" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16,18,16,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
            <Image Source="/TmuxHub.Windows;component/Assets/TmuxHub.Windows.png"
                   Width="29" Height="29" Stretch="Uniform" />
          </Border>
          <TextBlock Grid.Column="1" Text="TmuxHub" FontSize="18"
                     FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
          <TextBlock Text="主机" FontWeight="SemiBold" Margin="2,0,0,7" />
          <TextBox x:Name="SearchBox" ToolTip="搜索完整 SSH 主机库"
                   AutomationProperties.Name="搜索主机"
                   TextChanged="SearchBox_OnTextChanged" />
        </StackPanel>

        <ListBox x:Name="HostsList" Grid.Row="2"
                 SelectionChanged="HostsList_OnSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Destination}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Padding="7,2" Margin="8,0,0,0" CornerRadius="7"
                        Background="{StaticResource RaisedBrush}">
                  <TextBlock Text="{Binding Badge}" FontSize="10"
                             Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="地址" Style="{StaticResource CaptionText}" Margin="2,0,0,5" />
              <TextBox x:Name="AddHostBox" ToolTip="例如 prod 或 user@example.com"
                       AutomationProperties.Name="添加 SSH 地址"
                       KeyDown="AddHostBox_OnKeyDown" />
            </StackPanel>
            <Button x:Name="AddHostButton" Grid.Column="1" Content="＋"
                    Style="{StaticResource PrimaryIconButton}" VerticalAlignment="Bottom"
                    Margin="8,0,0,0" ToolTip="添加主机"
                    AutomationProperties.Name="添加主机" Click="AddHostButton_OnClick" />
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshHostsButton" Content="↻"
                    Style="{StaticResource IconButton}" ToolTip="刷新主机"
                    AutomationProperties.Name="刷新主机"
                    Margin="0,0,8,0" Click="RefreshHostsButton_OnClick" />
            <Button x:Name="EditSshConfigButton" Content="⚙"
                    Style="{StaticResource IconButton}" ToolTip="编辑 SSH 配置"
                    AutomationProperties.Name="编辑 SSH 配置"
                    Click="EditSshConfigButton_OnClick" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="SelectedHostTitle" Text="SSH"
                     Style="{StaticResource TitleText}" />
          <TextBlock x:Name="SelectedHostSubtitle" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PinButton" Content="☆" Style="{StaticResource IconButton}"
                  ToolTip="固定主机" AutomationProperties.Name="固定主机"
                  Margin="0,0,8,0" IsEnabled="False" Click="PinButton_OnClick" />
          <Button x:Name="RemoveHostButton" Content="−" Style="{StaticResource DangerIconButton}"
                  ToolTip="移除主机"
                  AutomationProperties.Name="移除主机"
                  Margin="0,0,8,0" IsEnabled="False" Click="RemoveHostButton_OnClick" />
          <Button x:Name="OpenShellButton" Content="&gt;_" Style="{StaticResource IconButton}"
                  ToolTip="打开 SSH Shell" AutomationProperties.Name="打开 SSH Shell"
                  Margin="0,0,8,0"
                  IsEnabled="False" Click="OpenShellButton_OnClick" />
          <Button x:Name="QuickConnectButton" Content="▶" Style="{StaticResource PrimaryIconButton}"
                  ToolTip="快速连接" AutomationProperties.Name="快速连接"
                  IsEnabled="False" Click="QuickConnectButton_OnClick" />
        </StackPanel>
      </Grid>

      <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Margin="0,16,0,0"
                  Background="Transparent" BorderThickness="0"
                  SelectionChanged="WorkspaceTabs_OnSelectionChanged">
        <TabItem Header="tmux">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="会话" FontWeight="SemiBold" />
                  <TextBox x:Name="SessionNameBox" Margin="0,8,0,0"
                           ToolTip="会话名，例如 main" KeyDown="SessionNameBox_OnKeyDown" />
                </StackPanel>
                <Button Grid.Column="1" Content="＋" Style="{StaticResource PrimaryIconButton}"
                        ToolTip="新建或连接" AutomationProperties.Name="新建或连接 tmux 会话"
                        Margin="12,24,0,0" VerticalAlignment="Center"
                        Click="ConnectNamedSessionButton_OnClick" />
                <Button Grid.Column="2" Content="↻" Style="{StaticResource IconButton}"
                        ToolTip="刷新会话" AutomationProperties.Name="刷新 tmux 会话"
                        Margin="8,24,0,0" VerticalAlignment="Center"
                        Click="RefreshSessionsButton_OnClick" />
                <Button x:Name="ConfigureTmuxButton" Grid.Column="3" Content="⚙"
                        Style="{StaticResource IconButton}" ToolTip="一键配置 tmux"
                        AutomationProperties.Name="一键配置 tmux"
                        Margin="8,24,0,0" VerticalAlignment="Center"
                        Click="ConfigureTmuxButton_OnClick" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
              <DataGrid x:Name="SessionGrid" AutoGenerateColumns="False"
                        SelectionChanged="SessionGrid_OnSelectionChanged"
                        MouseDoubleClick="SessionGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="会话" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="服务器 ID" Binding="{Binding ServerSessionIdDisplay}" Width="150" />
                  <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtDisplay}" Width="190" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SessionHint" Visibility="Collapsed" />
              <Button x:Name="OpenSessionButton" Grid.Column="1" Content="▶"
                      Style="{StaticResource PrimaryIconButton}" ToolTip="打开会话"
                      AutomationProperties.Name="打开 tmux 会话" IsEnabled="False"
                      Click="OpenSessionButton_OnClick" />
              <Button x:Name="RenameSessionButton" Grid.Column="2" Content="✎"
                      Style="{StaticResource IconButton}" ToolTip="重命名"
                      AutomationProperties.Name="重命名 tmux 会话"
                      IsEnabled="False" Margin="8,0,0,0"
                      Click="RenameSessionButton_OnClick" />
              <Button x:Name="TerminateSessionButton" Grid.Column="3" Content="终止会话"
                      Style="{StaticResource DangerButton}" IsEnabled="False" Margin="8,0,0,0"
                      Click="TerminateSessionButton_OnClick" />
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Herdr">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="工作区" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="↻" Style="{StaticResource IconButton}"
                        ToolTip="刷新 Herdr" AutomationProperties.Name="刷新 Herdr"
                        Click="RefreshHerdrButton_OnClick" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
              <DataGrid x:Name="HerdrGrid" AutoGenerateColumns="False"
                        SelectionChanged="HerdrGrid_OnSelectionChanged"
                        MouseDoubleClick="HerdrGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="会话" Binding="{Binding SessionDisplay}" Width="105" />
                  <DataGridTextColumn Header="工作区" Binding="{Binding WorkspaceLabel}" Width="150" />
                  <DataGridTextColumn Header="终端" Binding="{Binding Label}" Width="*" />
                  <DataGridTextColumn Header="Agent" Binding="{Binding AgentDisplay}" Width="130" />
                  <DataGridTextColumn Header="目录" Binding="{Binding WorkingDirectoryDisplay}" Width="220" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="HerdrHint" Visibility="Collapsed" />
              <Button x:Name="OpenHerdrButton" Grid.Column="1" Content="▶"
                      Style="{StaticResource PrimaryIconButton}" ToolTip="打开终端"
                      AutomationProperties.Name="打开 Herdr 终端" IsEnabled="False"
                      Click="OpenHerdrButton_OnClick" />
            </Grid>
          </Grid>
        </TabItem>

        <TabItem Header="Slurm">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="资源" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="↻" Style="{StaticResource IconButton}"
                          ToolTip="刷新任务" AutomationProperties.Name="刷新 Slurm 任务"
                          Margin="0,0,8,0"
                          Click="RefreshSlurmButton_OnClick" />
                  <Button x:Name="StartSlurmButton" Grid.Column="2" Content="＋"
                          Style="{StaticResource PrimaryIconButton}"
                          ToolTip="启动交互环境" AutomationProperties.Name="启动 Slurm 交互环境"
                          Click="StartSlurmButton_OnClick" />
                </Grid>

                <UniformGrid Columns="6" Margin="0,12,0,0">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="用户" Style="{StaticResource CaptionText}" />
                    <TextBox x:Name="SlurmOwnerBox" Margin="0,5,0,0" ToolTip="集群用户名" />
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="分区" Style="{StaticResource CaptionText}" />
                    <TextBox x:Name="SlurmPartitionBox" Margin="0,5,0,0" Text="debug" />
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="CPU" Style="{StaticResource CaptionText}" />
                    <TextBox x:Name="SlurmCpuBox" Margin="0,5,0,0" Text="4" />
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="内存 MiB" Style="{StaticResource CaptionText}" />
                    <TextBox x:Name="SlurmMemoryBox" Margin="0,5,0,0" Text="16384" />
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="时限 min" Style="{StaticResource CaptionText}" />
                    <TextBox x:Name="SlurmMinutesBox" Margin="0,5,0,0" Text="30" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="GPU" Style="{StaticResource CaptionText}" />
                    <TextBox x:Name="SlurmGpuBox" Margin="0,5,0,0" Text="1"
                             ToolTip="0 表示不申请 GPU" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
              <DataGrid x:Name="SlurmGrid" AutoGenerateColumns="False"
                        SelectionChanged="SlurmGrid_OnSelectionChanged"
                        MouseDoubleClick="SlurmGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Job" Binding="{Binding JobId}" Width="90" />
                  <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90" />
                  <DataGridTextColumn Header="分区" Binding="{Binding Partition}" Width="100" />
                  <DataGridTextColumn Header="运行" Binding="{Binding Time}" Width="120" />
                  <DataGridTextColumn Header="节点" Binding="{Binding Nodes}" Width="130" />
                  <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SlurmSummaryText" Text="—"
                         VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
              <Button x:Name="OpenSlurmButton" Grid.Column="1" Content="▶"
                      Style="{StaticResource PrimaryIconButton}" ToolTip="连接任务"
                      AutomationProperties.Name="连接 Slurm 任务"
                      IsEnabled="False" Click="OpenSlurmButton_OnClick" />
              <Button x:Name="CancelSlurmButton" Grid.Column="2" Content="取消任务"
                      Style="{StaticResource DangerButton}" IsEnabled="False"
                      Margin="8,0,0,0" Click="CancelSlurmButton_OnClick" />
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>

      <Grid Grid.Row="2" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪"
                   Margin="8,0,0,0" Style="{StaticResource CaptionText}"
                   VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
</Window>
